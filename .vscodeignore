# The downstream repo carries only release files, so the only
# exclusions needed are the build outputs and the sources that are shipped
# compiled.
.vscode/**
src/**
test/**
scripts/**
tsconfig*.json
**/*.map
**/*.ts
node_modules/**
node_modules/.bin/**
.gitignore
.gitattributes
.github/**
.DS_Store

# The screenshots are linked from the README as relative paths, and vsce
# rewrites those to the public raw URL of the downstream repo. They are
# served from the repository, not from inside the VSIX, so bundling them
# would only make the download bigger.
images/**

# Compiled but not loaded: the webview ships as the esbuild bundle in
# media/dashboard.js.
dist/webview/**

# Orphaned at runtime: src/core/connections.ts is imported only by the
# webview, which gets it inlined into media/dashboard.js by esbuild. The
# compiled file stays in dist/ because the test suite requires it.
dist/core/connections.js
